{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/worker/test/**/*.ts",
    "jobs/media/src/**/*.ts",
    "jobs/media/src/**/*.tsx",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/functions/**/*.ts",
    "apps/web/test/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "infra/cloudflare/*/src/**/*.ts",
    "infra/cloudflare/*/test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
