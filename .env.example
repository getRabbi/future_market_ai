# FUTUREGROW AI — environment reference. Copy to .env for local runs; in Northflank put secrets in a
# secret group (see infra/northflank/template.json). Never commit real values.

# --- Core -----------------------------------------------------------------------------------------
NODE_ENV=development                 # production requires the three secrets below and https URLs
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:futuregrow-dev@localhost:54320/futuregrow   # npm run dev:db
DATABASE_POOL_MAX=5
# TLS to PostgreSQL is always verify-full (chain + host name); there is no unverified mode.
# Unset = follow sslmode in DATABASE_URL (production defaults to TLS). true/false force it.
DATABASE_SSL=false
DATABASE_SSL_CA=                     # optional private CA: PEM text or a file path (Node services and Python jobs)
API_BASE_URL=http://localhost:8080   # public API URL (Better Auth, unsubscribe and referral links)
APP_BASE_URL=http://localhost:4321   # web control plane
APP_ORIGINS=http://localhost:4321    # comma-separated browser origins (CORS + Better Auth trustedOrigins)

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=                  # >= 32 chars
FG_SECRETS_KEY=                      # base64 32 bytes: AES-256-GCM key for connection credentials
FG_SECRETS_KEY_VERSION=1
FG_SECRETS_KEY_PREVIOUS=             # optional base64 key of version N-1, kept readable during rotation
FG_IDENTIFIER_PEPPER=                # >= 16 chars; rotating it invalidates suppression matching
FG_ALLOW_SIGNUP=false                # invite-only beta
FG_CHECK_BREACHED_PASSWORDS=true     # HaveIBeenPwned k-anonymity check (production)

# --- Object storage: Cloudflare R2 (S3 API). Local dev uses the filesystem when unset.
R2_ACCOUNT_ID=
R2_ENDPOINT=                         # https://<account>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FG_LOCAL_STORAGE_DIR=.data/objects   # development only; refused in production
FG_MEDIA_PUBLIC_BASE_URL=            # optional public base for media handed to platforms (else presigned URLs)
FG_MAX_UPLOAD_BYTES=52428800

# --- Backups (D-030; analytics-job image)
FG_BACKUP_KEY=                       # base64 32 bytes; store separately from R2 credentials
R2_BACKUP_BUCKET=                    # optional separate bucket for backups (defaults to R2_BUCKET)
FG_BACKUP_FS_DIR=                    # local runs only: write backups to a directory instead of R2

# --- Model gateway (B-003). Without a key every agent stage abstains.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=                  # hosted providers: each key enables one provider; models still need registry approval
OPENAI_API_KEY=
GEMINI_API_KEY=                      # approve Gemini models only on a paid (billing-enabled) project
GROQ_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=          # optional self-hosted / approved OpenAI-compatible endpoint
OPENAI_COMPATIBLE_API_KEY=
EMBEDDINGS_BASE_URL=                 # optional (D-007); full-text retrieval works without it
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
FG_TENANT_AI_MONTHLY_LIMIT_USD=      # optional platform default monthly model spend limit per tenant (USD); tenants override with aiSpend
FG_AUTOPILOT=on                     # Autopilot platform switch (D-033): "off" stops every goal; organizations still opt in one by one

# --- Operator alerts (DEPLOYMENT §9). Unset = structured log only.
ALERT_WEBHOOK_URL=                   # https Slack/Discord incoming webhook or any JSON endpoint
ALERT_ENVIRONMENT=                   # optional label; defaults to "<NODE_ENV> <APP_BASE_URL host>"

# --- Provider webhooks and API versions (B-005..B-009)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=           # >= 16 chars
SHOPIFY_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=               # svix signing secret (whsec_...)
TIKTOK_CLIENT_SECRET=
META_GRAPH_API_VERSION=v26.0
GOOGLE_ADS_API_VERSION=v26
SHOPIFY_API_VERSION=2026-10

# --- Execution verification (M24)
VERIFICATION_MAX_ATTEMPTS=12
VERIFICATION_BASE_DELAY_SECONDS=15

# --- Worker and jobs
WORKER_CONCURRENCY=2
# WORKER_CRONTAB=                    # override the built-in schedule (empty string disables cron)
ANALYTICS_MAX_SECONDS=900
MEDIA_MAX_SECONDS=1200
RENDER_CONCURRENCY=1
NORTHFLANK_API_TOKEN=                # optional: trigger jobs immediately when work is queued
NORTHFLANK_PROJECT_ID=
NORTHFLANK_ANALYTICS_JOB_ID=
NORTHFLANK_MEDIA_JOB_ID=

# --- Web (build time, Cloudflare Pages)
PUBLIC_API_BASE=                     # empty when the Pages Functions proxy serves /v1 and /api/auth
