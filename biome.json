{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/.astro", "!**/.tools", "!**/.data", "!**/drizzle/meta", "!**/*.md"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
      "suspicious": { "noExplicitAny": "warn" },
      "complexity": { "noForEach": "off" }
    }
  }
}
