---
import { ControlPlane } from '../../components/ControlPlane.tsx';
import Base from '../../layouts/Base.astro';
import { PAGES } from '../../lib/nav.ts';

export function getStaticPaths() {
  return PAGES.filter((p) => p.slug).map((p) => ({ params: { section: p.slug }, props: { title: p.title } }));
}

const { section } = Astro.params;
const { title } = Astro.props as { title: string };
---

<Base title={`${title} — FUTUREGROW`} noindex>
  <ControlPlane client:only="react" section={section} />
</Base>
