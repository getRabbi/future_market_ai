---
import { MODULES } from '@futuregrow/contracts';
import Base from '../layouts/Base.astro';

const groups = [
  { title: 'Foundation', ids: ['M01', 'M02', 'M03'] },
  { title: 'Intelligence', ids: ['M04', 'M05', 'M06', 'M07', 'M08', 'M09', 'M10', 'M11'] },
  { title: 'Creation', ids: ['M12', 'M13', 'M14', 'M15'] },
  { title: 'Channels', ids: ['M16', 'M17', 'M18', 'M19', 'M20', 'M21', 'M22'] },
  { title: 'Control', ids: ['M23', 'M24'] },
];
const byId = new Map(MODULES.map((m) => [m.id, m]));
---

<Base title="FUTUREGROW AI — evidence-governed growth">
  <main class="landing" id="content">
    <section class="hero">
      <p class="small muted">Controlled beta · invitation only</p>
      <h1>Growth automation that proves what it did.</h1>
      <p>
        FUTUREGROW turns first-party data, market evidence and experiments into growth decisions. Models propose; deterministic code checks evidence, policy, budgets and approvals, executes through official APIs, and
        independently verifies every result before anything is counted as done.
      </p>
      <p class="row" style="margin-top: 1.25rem">
        <a class="btn primary" href="/login">Sign in</a>
        <a class="btn" href="#principles">How it stays safe</a>
      </p>
    </section>

    <section id="principles" style="margin-top: 2.5rem">
      <h2>Operating principles</h2>
      <div class="modules">
        <div><strong>Evidence first.</strong> Every fact carries its source, licence, freshness and permitted uses. Untrusted or stale evidence cannot drive automation.</div>
        <div><strong>Bounded autonomy.</strong> A deny-by-default action allowlist, per-category autonomy policy, spend ceilings and two-person approvals for anything consequential.</div>
        <div><strong>Verified execution.</strong> No action is "successful" because an API returned 200. It is VERIFIED by an independent read-back, or it fails, rolls back or escalates.</div>
        <div><strong>Consent and disclosure.</strong> Consent and suppression are checked immediately before every message; synthetic personas and paid partnerships are always disclosed.</div>
        <div><strong>Measured, not assumed.</strong> Forecasts ship with backtests and intervals, media mix with convergence diagnostics, experiments with logged assignment and SRM checks.</div>
        <div><strong>Stop anything.</strong> Kill switches at tenant, connector, object, model and agent scope, checked again right before every provider call.</div>
      </div>
    </section>

    <section style="margin-top: 2.5rem">
      <h2>All 24 modules</h2>
      {
        groups.map((g) => (
          <>
            <h3 style="margin-top: 1.25rem">{g.title}</h3>
            <div class="modules">
              {g.ids.map((id) => {
                const m = byId.get(id)!;
                return (
                  <div>
                    <div class="small muted">{m.id}</div>
                    <strong>{m.name}</strong>
                    <p class="small" style="margin: 0.25rem 0 0">{m.purpose}</p>
                  </div>
                );
              })}
            </div>
          </>
        ))
      }
    </section>

    <footer class="small muted" style="margin-top: 3rem">
      Beta limitations, integration status and blocked capabilities are listed in the operator documentation. Rankings, revenue and growth outcomes are never promised.
    </footer>
  </main>
</Base>
